{
  "_comment": "Copy to local.settings.json (git-ignored) and fill in. Uses your `az login` identity, so grant YOURSELF the same data roles as the Functions managed identity (Service Bus Data Receiver, Event Hubs Data Receiver, Storage Blob Data Contributor, Cosmos DB Built-in Data Contributor).",
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",

    "ServiceBus__fullyQualifiedNamespace": "<your-namespace>.servicebus.windows.net",
    "EventHubs__fullyQualifiedNamespace": "<your-namespace>.servicebus.windows.net",

    "Cosmos__Endpoint": "https://<your-account>.documents.azure.com:443/",
    "ConnectionStrings__OrdersSql": "Server=tcp:<your-server>.database.windows.net,1433;Database=cloudmart;Authentication=Active Directory Default;Encrypt=True;",
    "Storage__BlobEndpoint": "https://<your-account>.blob.core.windows.net/",

    "AzureWebJobs.DailyOrderReport.Disabled": "true"
  }
}
